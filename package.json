{
  "name": "portal.pitell",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test tests/e2e/company-appointment-create.api.spec.ts",
    "test:e2e:booking": "playwright test --project=booking-flow",
    "test:e2e:refresh": "playwright test --project=auth-refresh",
    "test:e2e:report": "npx kill-port 9323 && playwright show-report",
    "build": "react-router build",
    "dev": "npx kill-port 5173 && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "gen:api": "openapi-ts && tsx scripts/openapi/post-generate-aliases.ts && prettier --write app/api/generated",
    "generate:api": "openapi-ts && tsx scripts/openapi/post-generate-aliases.ts && prettier --write app/api/generated"
  },
